<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_sensors</name>
  <version>0.1.0</version>
  <description>BNO086 IMU (UART-RVC) and Waveshare L76X GPS drivers - both wired straight to USB with no Arduino involved.</description>
  <maintainer email="rover@toolboxrobotics.local">Toolbox Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-serial</depend>
  <depend>python3-pynmea2</depend>
  <depend>python3-opencv</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
