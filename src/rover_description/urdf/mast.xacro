<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mast_length" value="0.40"/>
  <xacro:property name="mast_radius" value="0.018"/>
  <xacro:property name="mast_mass" value="0.7"/>

  <joint name="chassis_to_mast_base" type="fixed">
    <parent link="chassis_link"/>
    <child link="mast_base_link"/>
    <origin xyz="${-wheelbase_rear - 0.02} 0 ${chassis_height/2.0}" rpy="0 0 0"/>
  </joint>
  <link name="mast_base_link">
    <visual><geometry><box size="0.05 0.05 0.03"/></geometry><material name="mast_silver"/></visual>
    <inertial><mass value="0.3"/><xacro:box_inertia mass="0.3" x="0.05" y="0.05" z="0.03"/></inertial>
  </link>

  <!-- Erect/stow pivot: 0 rad = horizontal/transport, pi/2 rad =
       vertical/service. Physically driven by the lift DC motor through
       whatever leadscrew/gearing translates its rotation into this
       ~90-degree hinge motion. -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 ${mast_length/2.0}" rpy="0 0 0"/>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
      <material name="mast_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_length/2.0}" rpy="0 0 0"/>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${mast_length/2.0}" rpy="0 0 0"/>
      <mass value="${mast_mass}"/>
      <xacro:cylinder_inertia mass="${mast_mass}" radius="${mast_radius}" length="${mast_length}"/>
    </inertial>
  </link>

  <joint name="mast_erect_joint" type="revolute">
    <parent link="mast_base_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 0.015" rpy="0 ${-3.14159265/2.0} 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="${3.14159265/2.0}" effort="6.0" velocity="0.5"/>
  </joint>

  <!-- 2-axis head at the mast tip. -->
  <link name="mast_head_yaw_link">
    <visual><geometry><cylinder radius="0.025" length="0.03"/></geometry><material name="sensor_dark"/></visual>
    <inertial><mass value="0.12"/><xacro:cylinder_inertia mass="0.12" radius="0.025" length="0.03"/></inertial>
  </link>
  <joint name="mast_head_yaw_joint" type="revolute">
    <parent link="mast_link"/>
    <child link="mast_head_yaw_link"/>
    <origin xyz="0 0 ${mast_length}" rpy="0 ${3.14159265/2.0} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-170.0*3.14159265/180.0}" upper="${170.0*3.14159265/180.0}" effort="2.0" velocity="2.0"/>
  </joint>

  <link name="mast_head_link">
    <visual><geometry><box size="0.08 0.05 0.04"/></geometry><material name="sensor_dark"/></visual>
    <collision><geometry><box size="0.08 0.05 0.04"/></geometry></collision>
    <inertial><mass value="0.25"/><xacro:box_inertia mass="0.25" x="0.08" y="0.05" z="0.04"/></inertial>
  </link>
  <joint name="mast_head_pitch_joint" type="revolute">
    <parent link="mast_head_yaw_link"/>
    <child link="mast_head_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-180.0*3.14159265/180.0}" upper="${180.0*3.14159265/180.0}" effort="2.0" velocity="2.0"/>
  </joint>

  <link name="mast_camera_optical_frame"/>
  <joint name="mast_camera_optical_joint" type="fixed">
    <parent link="mast_head_link"/>
    <child link="mast_camera_optical_frame"/>
    <origin xyz="0.04 0 0" rpy="${-3.14159265/2.0} 0 ${-3.14159265/2.0}"/>
  </joint>

</robot>
