<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="chassis_grey">
    <color rgba="0.55 0.55 0.58 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="arm_orange">
    <color rgba="0.85 0.35 0.05 1.0"/>
  </material>
  <material name="mast_silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="sensor_dark">
    <color rgba="0.15 0.15 0.17 1.0"/>
  </material>
  <material name="lens_glass">
    <color rgba="0.1 0.15 0.2 0.6"/>
  </material>
  <material name="solar_panel_blue">
    <color rgba="0.1 0.15 0.35 1.0"/>
  </material>
  <material name="antenna_hg_white">
    <color rgba="0.85 0.85 0.85 1.0"/>
  </material>

  <!-- Closed-form solid-box inertia about its own centroid. -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia
      ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
      iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
      izz="${mass * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <!-- Closed-form solid-cylinder inertia about its own centroid, axis
       along the link's local Z (rotate the joint/link frame, not this
       macro, if the physical axis is X or Y). -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertia
      ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
      iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0.0"
      izz="${mass * radius*radius / 2.0}"/>
  </xacro:macro>

</robot>
