    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://rover_description/meshes/left_differential.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
    <inertia ixx="0.0008333333333333335" ixy="0.0" ixz="0.0" iyy="0.0008333333333333335" iyz="0.0" izz="0.0008333333333333335"/>
  
    </inertial>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="left_differential_link"/>
    <child link="front_left_steering_link"/>
