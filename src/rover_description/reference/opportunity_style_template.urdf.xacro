  <!-- ================================================================================ -->
  <!-- Note: the original upload also had a second, separate set of "_trans"-suffixed
       transmissions duplicating several of the joints already given transmissions
       above (e.g. front_left_wheel_trans duplicating front_left_wheel_transmission),
       plus two entirely empty macro definitions (steered_wheel/fixed_wheel) whose 6
       invocations were no-ops. Both removed as dead/duplicate content - every joint
       already has exactly one transmission, declared alongside its joint above. -->
  <!-- ================================================================================ -->

  <!-- ================================================================== -->
  <!-- Arm link with Meshes -->
  <!-- ================================================================== -->

  <joint name="arm_j1_joint" type="revolute">
