    <child  link="arm_j1_link"/>
    <origin xyz="0.3 0.09 -0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="8" velocity="1.5"/>
