      </geometry>
      <material name="antenna_base_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${ant_j1}"/></geometry>
    </collision>
    <inertial>
