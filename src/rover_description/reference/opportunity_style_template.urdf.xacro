  <!-- Sensors and additional components -->
  <!-- ========================================================= -->

  <!-- Antenna High Gain -->
  <joint name="ant_j1_joint" type="revolute">
    <parent link="body_box_link"/>
    <child  link="ant_j1_link"/>
    <origin xyz="-0.24 0.26 -0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="ant_j1_link">
    <visual>
      <origin xyz="0.24 -0.26 0.02" rpy="0 0 0"/>
