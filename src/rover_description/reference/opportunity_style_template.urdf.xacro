  <joint name="arm_j4_joint" type="revolute">
    <parent link="arm_j3_link"/>
    <child  link="arm_j4_link"/>
    <origin xyz="0.235 -0.021 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="4" velocity="1.5"/>
  </joint>

  <link name="arm_j4_link">
