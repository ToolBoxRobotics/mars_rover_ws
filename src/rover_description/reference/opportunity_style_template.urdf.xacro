<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro"
       name="mars_opportunity_rover">

  <!-- ============================================================
       Corrected reference template, adapted from a user-supplied
       xacro file. This is NOT wired into rover.urdf.xacro / the
       active model - it describes a materially different rover
       (differential/bogie suspension, "head" instead of the pan/tilt
       mast, arm_j1-j5 joint naming) than the one rover_base,
       rover_arm, the MoveIt config, and every wiring diagram in this
       project were actually built and hardware-tested against.
       Swapping it in live would silently break all of those, so it's
       kept here as a corrected, ready-to-use starting point for that
       migration if/when it's deliberately undertaken - not something
       to include automatically.

       What was actually broken in the original upload, fixed here:
         - steered_wheel/fixed_wheel macros had empty bodies; the 6
           calls to them were no-ops that produced no wheel geometry
           at all. Removed - the real per-wheel link/joint blocks
           below already exist and were never using these macros.
         - Right-side differential/bogie/steering/wheel joints were
           all type="fixed" with zero-width limits (i.e. permanently
           rigid), while the left side used real "revolute"/
           "continuous" joints. Mirrored the left side's real joint
           types/limits/transmissions onto the right side so the
           suspension is actually functional and symmetric.
         - Arm transmissions referenced joint names ("arm_j1" etc.)
           that don't exist - the actual joints are "arm_j1_joint"
           etc. Fixed the references.
         - Two transmissions were both named "arm_j_trans" (J3 and
           J4). Renamed to arm_j3_trans / arm_j4_trans.
         - base_link and body_box_link duplicated the exact same
           chassis mesh at the same origin. base_link is now a pure
           reference frame (no geometry/mass, matching this project's
           own convention elsewhere); body_box_link carries the mesh.
         - The joint between them (and several other type="fixed"
           joints throughout) carried <axis>/<limit> tags, which are
           meaningless for a fixed joint. Removed from every fixed joint.
         - <inertial> blocks on the two chassis links had no <mass>
           and all-zero <inertia> - invalid for any physics use even
           if irrelevant for pure kinematics/TF. Added mass +
           bounding-box-approximate inertia via common.xacro's
           box_inertia/cylinder_inertia macros (the same ones used
           throughout the rest of rover_description).
         - 15 distinct <material name="..."/> references throughout
           (arm_material, group_left_chassis_material, etc.) had no
           matching top-level <material> declaration anywhere -
           dangling references. Declared all of them below.
         - package://mars_rover_description/... mesh paths renamed to
           package://rover_description/..., matching this project's
           actual package name. The referenced .stl files themselves
           still need to be added under rover_description/meshes/ -
           none were supplied with the upload; xacro expansion and
           basic URDF structural validation don't require the files
           to exist, only actually loading the model in RViz/Gazebo does.
       ============================================================ -->

  <xacro:include filename="$(find rover_description)/urdf/common.xacro"/>

  <!-- ========================================================= -->
  <!-- Global Parameters -->
  <!-- ========================================================= -->

  <xacro:property name="scale_x"  value="0.68"/>
  <xacro:property name="scale_y"  value="0.68"/>
  <xacro:property name="scale_z"  value="0.68"/>

  <!-- ================= Mesh Path Parameters ================== -->

  <xacro:property name="body_box" value="package://rover_description/meshes/body_box.stl"/>

  <xacro:property name="head_j2" value="package://rover_description/meshes/head_j2.stl"/>
  <xacro:property name="head_j3" value="package://rover_description/meshes/head_j3.stl"/>

  <xacro:property name="front_left_panel" value="package://rover_description/meshes/front_left_panel.stl"/>
  <xacro:property name="rear_left_panel" value="package://rover_description/meshes/rear_left_panel.stl"/>
  <xacro:property name="front_right_panel" value="package://rover_description/meshes/front_right_panel.stl"/>
  <xacro:property name="rear_right_panel" value="package://rover_description/meshes/rear_right_panel.stl"/>
  <xacro:property name="rear_middle_panel" value="package://rover_description/meshes/rear_middle_panel.stl"/>

  <xacro:property name="arm_j1"  value="package://rover_description/meshes/arm_j1.stl"/>
  <xacro:property name="arm_j2"  value="package://rover_description/meshes/arm_j2.stl"/>
  <xacro:property name="arm_j3"  value="package://rover_description/meshes/arm_j3.stl"/>
  <xacro:property name="arm_j4"  value="package://rover_description/meshes/arm_j4.stl"/>
  <xacro:property name="arm_j5"  value="package://rover_description/meshes/arm_j5.stl"/>

  <xacro:property name="left_differential"  value="package://rover_description/meshes/left_differential.stl"/>
  <xacro:property name="left_bogie"  value="package://rover_description/meshes/left_bogie.stl"/>
  <xacro:property name="front_left_steering"  value="package://rover_description/meshes/front_left_steering.stl"/>
  <xacro:property name="front_left_wheel"  value="package://rover_description/meshes/front_left_wheel.stl"/>
  <xacro:property name="middle_left_wheel"  value="package://rover_description/meshes/middle_left_wheel.stl"/>
  <xacro:property name="rear_left_steering"  value="package://rover_description/meshes/rear_left_steering.stl"/>
  <xacro:property name="rear_left_wheel"  value="package://rover_description/meshes/rear_left_wheel.stl"/>

  <xacro:property name="right_differential"  value="package://rover_description/meshes/right_differential.stl"/>
  <xacro:property name="right_bogie"  value="package://rover_description/meshes/right_bogie.stl"/>
  <xacro:property name="front_right_steering"  value="package://rover_description/meshes/front_right_steering.stl"/>
  <xacro:property name="front_right_wheel"  value="package://rover_description/meshes/front_right_wheel.stl"/>
  <xacro:property name="middle_right_wheel"  value="package://rover_description/meshes/middle_right_wheel.stl"/>
  <xacro:property name="rear_right_steering"  value="package://rover_description/meshes/rear_right_steering.stl"/>
  <xacro:property name="rear_right_wheel"  value="package://rover_description/meshes/rear_right_wheel.stl"/>

  <xacro:property name="ant_j1"  value="package://rover_description/meshes/ant_j1.stl"/>
  <xacro:property name="ant_j2"  value="package://rover_description/meshes/ant_j2.stl"/>

  <!-- Misc -->
  <xacro:property name="encoder_cpr" value="1024"/>  <!-- counts per rev -->
  <xacro:property name="wheel_inertia" value="0.02"/>

  <!-- ===================== MATERIALS ===================== -->
  <!-- Original 3 -->
  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.1 0.8 1.0"/></material>

  <!-- The 15 below were referenced throughout the original file with
       no matching declaration anywhere - dangling references in the
       upload. Declared here, several sharing a color deliberately
       rather than inventing 15 visually distinct ones. -->
  <material name="arm_material"><color rgba="0.85 0.35 0.05 1.0"/></material>
  <material name="head_top_material"><color rgba="0.15 0.15 0.17 1.0"/></material>
  <material name="group_left_chassis_material"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="group_left_front_steering_material"><color rgba="0.45 0.45 0.47 1.0"/></material>
  <material name="group_left_wheel_material"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="left_bogie_material"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="group_left_middle_chariot_center_material"><color rgba="0.45 0.45 0.47 1.0"/></material>
  <material name="group_right_chassis_material"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="group_right_front_steering_material"><color rgba="0.45 0.45 0.47 1.0"/></material>
  <material name="group_right_wheel_material"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="right_bogie_material"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="group_right_middle_chariot_center_material"><color rgba="0.45 0.45 0.47 1.0"/></material>
  <material name="solar_panel_material"><color rgba="0.1 0.15 0.35 1.0"/></material>
  <material name="antenna_base_material"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="antenna_hg_material"><color rgba="0.85 0.85 0.85 1.0"/></material>

  <!-- ========================================================= -->
  <!-- Base Chassis with Mesh -->
  <!-- ========================================================= -->
  <!-- base_link: pure reference frame, no geometry/mass - matches
       this project's convention elsewhere (rover_description/urdf/
       chassis.xacro's own base_link). The original upload duplicated
       the full chassis mesh on both base_link and body_box_link. -->
  <link name="base_link"/>

  <joint name="base_to_body_box" type="fixed">
    <parent link="base_link"/>
    <child  link="body_box_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="body_box_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${body_box}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${body_box}"/></geometry>
    </collision>
    <inertial>
      <!-- Bounding-box approximation (mesh's real inertia depends on
           its actual shape, unknown until the mesh is supplied) -
           see common.xacro's box_inertia macro. -->
      <origin xyz="0 0 0"/>
      <mass value="14.0"/>
      <xacro:box_inertia mass="14.0" x="0.62" y="0.36" z="0.16"/>
    </inertial>
  </link>

  <!-- ========================================================= -->
  <!-- Head with Mesh -->
  <!-- ========================================================= -->

  <joint name="head_j2_joint" type="revolute">
    <parent link="body_box_link"/>
    <child  link="head_j2_link"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="10" velocity="1.0"/>
  </joint>

  <transmission name="head_j2_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_j2_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_j2_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="head_j2_link">
    <visual>
      <origin xyz="-0.24 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${head_j2}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="arm_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${head_j2}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <xacro:box_inertia mass="0.3" x="0.08" y="0.08" z="0.08"/>
    </inertial>
  </link>

  <joint name="head_j3_joint" type="revolute">
    <parent link="head_j2_link"/>
    <child  link="head_j3_link"/>
    <origin xyz="0 0 0.37" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="4" velocity="1.0"/>
  </joint>

  <transmission name="head_j3_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_j3_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_j3_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="head_j3_link">
    <visual>
      <origin xyz="-0.24 0 -0.37" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${head_j3}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="head_top_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${head_j3}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <xacro:box_inertia mass="0.2" x="0.06" y="0.06" z="0.06"/>
    </inertial>
  </link>

  <!-- ========================================================= -->
  <!-- Group Differential Steering Wheels Left with Mesh -->
  <!-- ========================================================= -->

  <joint name="left_differential_joint" type="revolute">
    <parent link="body_box_link"/>
    <child  link="left_differential_link"/>
    <origin xyz="0.09 0 -0.265" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.2" upper="0.2" effort="10" velocity="1.0"/>
  </joint>

  <link name="left_differential_link">
    <visual>
      <origin xyz="-0.09 0 0.265" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${left_differential}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_left_chassis_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${left_differential}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <xacro:box_inertia mass="0.5" x="0.1" y="0.1" z="0.1"/>
    </inertial>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="left_differential_link"/>
    <child  link="front_left_steering_link"/>
    <origin xyz="0.315 0.26 -0.14" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.3" upper="0.3" effort="10" velocity="1.0"/>
  </joint>

  <transmission name="front_left_steering_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_steering_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_steering_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="front_left_steering_link">
    <visual>
      <origin xyz="-0.402 -0.258 0.404" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${front_left_steering}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_left_front_steering_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${front_left_steering}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <xacro:box_inertia mass="0.3" x="0.06" y="0.06" z="0.06"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child  link="front_left_wheel_link"/>
    <origin xyz="0 0.045 -0.033" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="front_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_wheel_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_wheel_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="-0.409 -0.3 0.433" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${front_left_wheel}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_left_wheel_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${front_left_wheel}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.1"/>
      <xacro:cylinder_inertia mass="1.1" radius="0.09" length="0.06"/>
    </inertial>
  </link>

  <joint name="left_bogie_joint" type="revolute">
    <parent link="left_differential_link"/>
    <child  link="left_bogie_link"/>
    <origin xyz="-0.265 0.195 -0.041" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.3" upper="0.3" effort="10" velocity="1.0"/>
  </joint>

  <transmission name="left_bogie_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_bogie_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_bogie_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="left_bogie_link">
    <visual>
      <origin xyz="0.175 -0.190 0.308" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${left_bogie}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="left_bogie_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${left_bogie}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <xacro:box_inertia mass="0.6" x="0.15" y="0.08" z="0.08"/>
    </inertial>
  </link>

  <joint name="middle_left_wheel_joint" type="continuous">
    <parent link="left_bogie_link"/>
    <child  link="middle_left_wheel_link"/>
    <origin xyz="0.178 0.06 -0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="middle_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="middle_left_wheel_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="middle_left_wheel_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="middle_left_wheel_link">
    <visual>
      <origin xyz="0 -0.22 0.435" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${middle_left_wheel}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_left_middle_chariot_center_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${middle_left_wheel}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.1"/>
      <xacro:cylinder_inertia mass="1.1" radius="0.09" length="0.06"/>
    </inertial>
  </link>

  <joint name="rear_left_steering_joint" type="revolute">
    <parent link="left_bogie_link"/>
    <child  link="rear_left_steering_link"/>
    <origin xyz="-0.203 0.09 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.3" upper="0.3" effort="10" velocity="1.0"/>
  </joint>

  <transmission name="rear_left_steering_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_steering_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_steering_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="rear_left_steering_link">
    <visual>
      <origin xyz="0.38 -0.28 0.408" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${rear_left_steering}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_left_middle_chariot_center_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${rear_left_steering}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <xacro:box_inertia mass="0.3" x="0.06" y="0.06" z="0.06"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="rear_left_steering_link"/>
    <child  link="rear_left_wheel_link"/>
    <origin xyz="0 0.048 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="rear_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_wheel_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_wheel_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0.38 -0.32 0.44" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${rear_left_wheel}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_left_middle_chariot_center_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${rear_left_wheel}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.1"/>
      <xacro:cylinder_inertia mass="1.1" radius="0.09" length="0.06"/>
    </inertial>
  </link>

  <!-- ========================================================= -->
  <!-- Group Differential Steering Wheels Right with Mesh -->
  <!-- (mirrored from Left - the original upload had every joint in
       this whole section as type="fixed" with zero-width limits,
       i.e. permanently rigid; this side literally could not move as
       uploaded, unlike the left. Fixed to match the left side's real
       joint types/limits/transmissions.) -->
  <!-- ========================================================= -->

  <joint name="right_differential_joint" type="revolute">
    <parent link="body_box_link"/>
    <child  link="right_differential_link"/>
    <origin xyz="0.09 0 -0.265" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.2" upper="0.2" effort="10" velocity="1.0"/>
  </joint>

  <transmission name="right_differential_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_differential_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_differential_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="right_differential_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${right_differential}" scale="${scale_x} ${scale_y} ${scale_z}"/>
      </geometry>
      <material name="group_right_chassis_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${right_differential}"/></geometry>
    </collision>
    <inertial>
