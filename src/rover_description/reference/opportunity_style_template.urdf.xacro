  <!-- IMU link (attached to base) -->
  <link name="imu_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.02 0.02 0.01"/></geometry></visual>
    <inertial><mass value="0.02"/><xacro:box_inertia mass="0.02" x="0.02" y="0.02" z="0.01"/></inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="body_box_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Kinect RGB-D camera -->
  <link name="camera_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.06 0.04 0.04"/></geometry></visual>
    <inertial><mass value="0.15"/><xacro:box_inertia mass="0.15" x="0.06" y="0.04" z="0.04"/></inertial>
  </link>

  <joint name="camera_mount" type="fixed">
    <parent link="body_box_link"/>
    <child link="camera_link"/>
    <origin xyz="0.2 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Gazebo plugins -->
  <!-- ========================================================= -->
  <!-- Left as reference/incomplete on purpose - reconciling these
       joint names (and picking an actual drive controller) against
       this project's real rover_base firmware protocol is exactly
       the "configuration" work explicitly deferred for this pass. -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <updateRate>50</updateRate>
      <leftJoint>front_left_wheel_joint middle_left_wheel_joint rear_left_wheel_joint</leftJoint>
      <rightJoint>front_right_wheel_joint middle_right_wheel_joint rear_right_wheel_joint</rightJoint>
    </plugin>
  </gazebo>

