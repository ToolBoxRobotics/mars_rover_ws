  <!-- Arm transmissions - joint references fixed to match the actual
       joint names above (arm_j1_joint, not arm_j1), and the
       duplicate "arm_j_trans" name (originally used for both J3 and
       J4) split into arm_j3_trans / arm_j4_trans. -->
  <transmission name="arm_j1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="arm_j1_joint"/>
    <actuator name="arm_j1_motor"/>
  </transmission>

  <transmission name="arm_j2_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="arm_j2_joint"/>
    <actuator name="arm_j2_motor"/>
