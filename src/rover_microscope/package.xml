<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_microscope</name>
  <version>0.1.0</version>
  <description>Microscope Uno #4 bridge (focus/zoom, LED, lens cover) plus the USB microscope camera publisher with snapshot/recording.</description>
  <maintainer email="rover@toolboxrobotics.local">Toolbox Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rover_msgs</depend>
  <depend>rover_protocol</depend>
  <depend>python3-serial</depend>
  <depend>python3-opencv</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
