<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_base</name>
  <version>0.1.0</version>
  <description>Base Mega #1 bridge: 6-wheel drive, 4-corner steering, quadrature encoders, wheel odometry.</description>
  <maintainer email="rover@toolboxrobotics.local">Toolbox Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rover_msgs</depend>
  <depend>rover_protocol</depend>
  <depend>python3-serial</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
